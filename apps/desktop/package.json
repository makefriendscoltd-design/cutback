{
  "name": "@cutback/desktop",
  "version": "0.1.7",
  "description": "CapCut AI 편집 어시스턴트 - Electron Desktop App",
  "main": "dist/main/index.js",
  "author": "CapCut AI Assistant Team",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "vite",
    "dev:electron": "tsc -p tsconfig.main.json && tsc -p tsconfig.preload.json && electron .",
    "build": "pnpm run build:main && pnpm run build:preload && pnpm run build:renderer",
    "build:main": "tsc -p tsconfig.main.json --noEmit && node build-main.mjs",
    "build:preload": "tsc -p tsconfig.preload.json",
    "build:renderer": "vite build",
    "lint": "eslint src --ext .ts,.tsx",
    "type-check": "tsc --noEmit",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "release": "electron-builder --publish always"
  },
  "dependencies": {
    "better-sqlite3": "^11.0.0",
    "electron-log": "^5.1.0",
    "electron-updater": "^6.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zeromq": "^6.5.0",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@cutback/audio-engine": "workspace:*",
    "@cutback/capcut-controller": "workspace:*",
    "@cutback/core": "workspace:*",
    "@cutback/preset-manager": "workspace:*",
    "@cutback/shared": "workspace:*",
    "@cutback/shorts-composer": "workspace:*",
    "@cutback/transcript-engine": "workspace:*",
    "@types/better-sqlite3": "^7.6.8",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.0",
    "typescript": "^5.5.0",
    "vite": "^5.4.0"
  }
}
