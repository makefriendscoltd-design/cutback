[
  {
    "start": 0.04,
    "end": 1.82,
    "text": "여러분 제가 정말"
  },
  {
    "start": 1.82,
    "end": 2.467,
    "text": "미쳤나 봅니다"
  },
  {
    "start": 2.494,
