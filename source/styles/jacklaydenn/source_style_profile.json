{
  "style_id": "jacklaydenn_reels_v1",
  "format": {"aspect_ratio":"9:16","reference_resolution":"720x1280","fps":24},
  "base_visual":"talking_head_anchor",
  "caption": {
    "semantic_chunk_words":[1,4],
    "font_impression":"heavy_rounded_sans",
    "primary_color":"white",
    "outline_or_shadow":"dark_subtle",
    "default_zone":"center_to_lower_center",
    "avoid_face":true,
    "full_sentence_default":false
  },
  "emphasis": {
    "big_keyword_scale_vs_caption":[1.7,3.0],
    "use_for":["numbers","names","strong_claims","contrast","conclusion"],
    "frequency":"sparse"
  },
  "modes": {
    "EXPLAINER":{"large_visual_change_sec":[2.0,4.0],"broll_burst_shots":[0,2]},
    "HYBRID":{"large_visual_change_sec":[1.2,2.5],"broll_burst_shots":[2,4]},
    "STORY_MONTAGE":{"montage_shot_sec":[0.45,1.2],"return_to_talking_head_within_sec":[4,8]}
  },
  "scene_types":[
    "TALKING_HEAD_BASE","WORD_CAPTION","BIG_KEYWORD","NAME_CARD",
    "TALKING_HEAD_WITH_PROOF","FULLSCREEN_PROOF","BROLL_FULL",
    "BROLL_BURST","SOCIAL_GRID","CUTOUT_PATTERN_INTERRUPT",
    "MONOCHROME_OR_INVERT_FLASH"
  ],
  "transition_default":"hard_cut",
  "zoom_policy":"meaningful_only",
  "broll_policy":"semantic_exactness_over_decoration",
  "pattern_interrupt_policy":{"max_per_video":2,"duration_sec":[0.2,1.5]}
}
