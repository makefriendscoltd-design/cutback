{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"Jacklaydenn Edit Plan",
  "type":"object",
  "required":["style_id","segments"],
  "properties":{
    "style_id":{"const":"jacklaydenn_reels_v1"},
    "global_mode":{"enum":["EXPLAINER","HYBRID","STORY_MONTAGE","AUTO"]},
    "segments":{
      "type":"array",
      "items":{
        "type":"object",
        "required":["start","end","dialogue","scene_type"],
        "properties":{
          "start":{"type":"number","minimum":0},
          "end":{"type":"number","minimum":0},
          "dialogue":{"type":"string"},
          "rhetorical_role":{"enum":["hook","explanation","claim","number","name","example","proof","story","emotion","transition","conclusion","cta"]},
          "mode":{"enum":["EXPLAINER","HYBRID","STORY_MONTAGE"]},
          "scene_type":{"enum":["TALKING_HEAD_BASE","WORD_CAPTION","BIG_KEYWORD","NAME_CARD","TALKING_HEAD_WITH_PROOF","FULLSCREEN_PROOF","BROLL_FULL","BROLL_BURST","SOCIAL_GRID","CUTOUT_PATTERN_INTERRUPT","MONOCHROME_OR_INVERT_FLASH"]},
          "caption":{
            "type":"object",
            "properties":{
              "text":{"type":"string"},
              "emphasis_word":{"type":["string","null"]},
              "size":{"enum":["small","normal","big","hero"]},
              "position":{"enum":["upper","center","lower_center","auto"]}
            }
          },
          "visual":{
            "type":"object",
            "properties":{
              "asset_query":{"type":["string","null"]},
              "requires_exact_asset":{"type":"boolean"},
              "shot_count":{"type":"integer","minimum":0,"maximum":8},
              "shot_duration_sec":{"type":["number","null"]},
              "proof_crop_instruction":{"type":["string","null"]}
            }
          },
          "treatment":{
            "type":"object",
            "properties":{
              "hard_cut":{"type":"boolean"},
              "cutout":{"type":"boolean"},
              "monochrome":{"type":"boolean"},
              "invert":{"type":"boolean"},
              "punch_in":{"type":"boolean"}
            }
          }
        }
      }
    }
  }
}
