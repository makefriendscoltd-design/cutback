{
  "name": "제품 광고 (보이스오버+B-roll)",
  "type": "custom",
  "version": "1.0.0",
  "description": "보이스오버 내레이션 + 제품 B-roll 영상 자동 조합. 빠른 컷 전환, 키워드 기반 매칭.",
  "editMode": "mode-b",
  "canvas": {
    "aspect_ratio": "9:16",
    "width": 1080,
    "height": 1920
  },
  "captions": {
    "segmentation_mode": "by_sentence",
    "max_chars_per_line": 18,
    "max_lines": 2,
    "line_break_optimization": true,
    "reasoning": "제품 광고는 문장 단위 자막. 2줄까지 허용하되 18자/줄로 가독성 유지."
  },
  "style": {
    "font_family": "Pretendard",
    "font_size": 44,
    "font_weight": 700,
    "text_color": "#FFFFFF",
    "outline_color": "#000000",
    "outline_width": 3,
    "shadow_enabled": true,
    "shadow_color": "#000000",
    "shadow_opacity": 0.4,
    "position_vertical": "bottom",
    "position_offset_percent": 18
  },
  "modeBParams": {
    "matchConfig": {
      "keywordMatching": {
        "enabled": true,
        "minScore": 0.3
      },
      "speedAdjustment": {
        "min": 0.8,
        "max": 1.3
      },
      "allowRepeat": false,
      "allowFreeze": true
    },
    "autoApplyThreshold": 0.6,
    "transitionStyle": "cut",
    "reasoning": "제품 광고는 빠른 컷으로 역동적 느낌. 키워드 매칭 최소 점수 0.3 (관대), 속도 조정 0.8~1.3배로 제한. 반복은 부자연스러우므로 비활성화, freeze frame은 허용."
  }
}
